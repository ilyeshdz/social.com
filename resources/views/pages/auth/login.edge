@layouts.auth({ title: 'Se connecter' })
  <h1 class="auth-sheet__title">Se connecter</h1>
  <p class="auth-sheet__sub">Content de vous revoir.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth-sheet__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'vous@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Se connecter',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Un instant…' : 'Se connecter'",
    })
  @end

  <p class="auth-sheet__foot">
    
    Pas encore de compte ?

    @link({ route: 'new_account.create', class: 'il' })
      S'inscrire
    @end
  </p>
@end
