@layouts.auth({ title: 'Créer un compte' })
  <h1 class="auth-sheet__title">Créer un compte</h1>
  <p class="auth-sheet__sub">Choisissez votre pseudo, c'est ce que les autres verront.</p>

  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth-sheet__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'username' })
      @!field.label({ text: 'Pseudo' })
      @!input.control({ autocomplete: 'username', placeholder: 'votre_pseudo' })
      <p class="field__hint">Lettres, chiffres et underscores — 3 à 30 caractères.</p>
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'vous@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Créer mon compte',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Un instant…' : 'Créer mon compte'",
    })
  @end

  <p class="auth-sheet__foot">
    Déjà un compte ?
    @link({ route: 'session.create', class: 'il' })
      Se connecter
    @end
  </p>
@end
