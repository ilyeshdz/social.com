@layouts.app({ title: 'Accueil' })
  <header class="feed__bar">
    <h1>Accueil</h1>
  </header>

  @if(!posts.length)
    <div class="feed__empty">
      <div class="feed__empty-mark">
        @svg('lucide:feather', { width: 22, height: 22 })
      </div>
      <p class="feed__empty-title">Aucun post pour le moment</p>
      <p class="feed__empty-sub">
        @if(auth.user)
          La timeline est vide. Soyez le premier à publier.
        @else
          Connectez-vous pour suivre la conversation.
        @end
      </p>
      @if(auth.user)
        <button type="button" class="btn btn--primary" x-on:click="composeOpen = true">
          Publier un post
        </button>
      @end
    </div>
  @else
    <div class="feed__list">
      @each(post in posts)
        <article class="post">
          @!avatar({ initials: post.user.initials, class: 'avatar post__avatar' })
          <div class="post__body">
            <div class="post__meta">
              <strong class="post__name">{{ post.user.username }}</strong>
              <span class="post__handle">{{ '@' + post.user.username }}</span>
              <span class="post__sep">·</span>
              <time class="post__date" datetime="{{ post.createdAt.toISO() }}">
                {{ post.createdAt.toFormat('d LLL yyyy') }}
              </time>
            </div>
            <div class="post__content">{{ post.content }}</div>
            <div class="post__stats">
              <span class="post__stat">
                @svg('lucide:message-circle', { width: 16, height: 16 })
                {{ post.commentsCount }}
              </span>
              <span class="post__stat">
                @svg('lucide:heart', { width: 16, height: 16 })
                {{ post.likesCount }}
              </span>
            </div>
          </div>
        </article>
      @end
    </div>
  @end
@end
