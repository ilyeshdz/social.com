@layouts.app({ title: 'Paramètres' })
  <header class="feed__bar">
    <h1>Paramètres</h1>
  </header>

  <div class="settings">
    <section class="settings__section">
      <h2 class="settings__title">Profil</h2>
      <p class="settings__hint">
        Votre profil est réduit à l'essentiel : pseudo, email et mot de passe.
      </p>
    </section>
    <section class="settings__section">
      <h2 class="settings__title">Apparence</h2>
      <p class="settings__hint">
        Le thème (clair ou sombre) se change depuis le menu situé sous votre pseudo dans la barre
        latérale.
      </p>
    </section>
  </div>
@end
